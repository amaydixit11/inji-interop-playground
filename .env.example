# The URL the playground is reachable at from every other participant.
# Leave as-is for browser-only runs against the built-in reference modules.
# For a phone wallet, set this to a tunnel URL (see README).
PUBLIC_URL=http://localhost:8787

# Inji Certify. Local Docker Compose default shown; the Collab sandbox also works.
CERTIFY_BASE_URL=http://localhost:8090/v1/certify
# Credential configuration id to request. Leave blank to auto-select the first
# configuration advertising the chosen format.
CERTIFY_CREDENTIAL_CONFIG_ID=

# Inji Verify verify-service.
VERIFY_BASE_URL=http://localhost:8000/v1/verify

# Inji Web, opened when the Inji Web wallet is selected.
INJI_WEB_URL=https://injiweb.collab.mosip.net
